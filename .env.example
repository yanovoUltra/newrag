# ===== 服务 =====
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
# 本地运行请显式选择 local-real / local-parser-benchmark。
# 留空仅兼容旧环境；不应作为可审计部署配置。
RUNTIME_PROFILE=
# auto（兼容旧环境）| demo（模型全关）| real（启用的真实能力缺失即拒绝启动）
MODEL_RUNTIME_MODE=auto
RUNTIME_ENDPOINT_PROBE=false
RUNTIME_PROBE_TIMEOUT=1

# ===== 身份与租户（生产使用 OIDC；HMAC 仅限内部服务）=====
# disabled | hmac | oidc
AUTH_MODE=disabled
OIDC_ISSUER=
OIDC_AUDIENCE=newrag-api
# 容器内可指向 Keycloak 内网 JWKS，浏览器仍使用公开 issuer
OIDC_JWKS_URL=
OIDC_ORG_CLAIM=org_id
OIDC_ROLES_CLAIM=realm_access.roles
OIDC_VISIBILITY_CLAIM=visibility
OIDC_FRONTEND_CLIENT_ID=newrag-web
# 仅 hmac 模式使用，不在前端或仓库中填写
AUTH_CLIENT_KEY=
AUTH_SECRET=

# ===== 存储 =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks
QDRANT_HNSW_EF=256
INDEX_SCHEMA_VERSION=2
PARSER_VERSION=layout-v1
CHUNKER_VERSION=small-to-big-v1
SPARSE_SCHEME=native-no-idf
REDIS_URL=redis://localhost:6379
# 缓存/会话专用 Redis；留空时回退 REDIS_URL
REDIS_CACHE_URL=

# ===== 嵌入 =====
# backend: api(百炼, 推荐) | flagembedding(本地 torch) | mock(测试用, 无真实语义)
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_BACKEND=api
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=./data/models
# API 后端：运行时自动映射为 DashScope 原生端点（.../api/v1，一次返回稠密 1024 维 + 模型原生稀疏；
# OpenAI 兼容端点不支持稀疏向量）。如需 workspace 网关，将 base 换成对应 ws-* 域名的 .../api/v1
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=16

# ===== LLM（OpenAI 兼容；与 local-real 的 DeepSeek 配置一致）=====
# provider: openai | mock(未配置密钥时的开发模拟，禁止生产使用)
LLM_PROVIDER=openai
RAGAS_DO_NOT_TRACK=true
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# 凭据通过环境变量、Docker Secret 或本机 keyring 注入，禁止提交真实值。
LLM_API_SECRET_NAME=LLM_API_KEY
LLM_MODEL=deepseek-v4-flash-vision-exp
LLM_TIMEOUT=60
RAGAS_JUDGE_MAX_TOKENS=4096
RAGAS_JUDGE_TIMEOUT=180
# 轻量模型（多模型路由：simple 问题走轻量，complex 走主模型；留空则全部走主模型）
LLM_LIGHT_BASE_URL=https://api.deepseek.com
LLM_LIGHT_API_KEY=
LLM_LIGHT_API_SECRET_NAME=LLM_API_KEY
LLM_LIGHT_MODEL=deepseek-v4-flash
LLM_ROUTER_FALLBACK_MODEL=

# ===== 重排序（阶段二）=====
# backend: api（百炼 workspace 网关 rerank） | none（RRF 直出，不重排）
RERANK_BACKEND=none
# 例：workspace 网关 https://{ws-id}.cn-beijing.maas.aliyuncs.com；公共端点 https://dashscope.aliyuncs.com
RERANK_API_BASE=https://dashscope.aliyuncs.com
RERANK_API_KEY=
# 外部 API 保持 true；无认证的本机兼容服务显式设为 false。
RERANK_API_AUTH_REQUIRED=true
# 本机服务可填 /healthz；外部服务无免费健康接口时保持空值。
RERANK_HEALTH_PATH=
RERANK_MODEL=qwen3-rerank
RERANK_INDICATOR_MODEL=
RERANK_NON_INDICATOR_MODEL=
# workspace 网关路径；公共端点路径为 /api/v1/services/rerank/text-rerank/generation
RERANK_API_PATH=/api/v1/services/rerank/text-rerank/text-rerank
RERANK_CANDIDATES=8

# ===== 检索（阶段二：混合检索）=====
RECALL_DENSE_TOP_K=50
RECALL_SPARSE_TOP_K=50
RECALL_TABLE_TOP_K=20
RRF_K=60
RETRIEVAL_TOP_K=8
# 置信度门控（仅 rerank 模式生效；RRF-only 模式请置 0）：top 命中分低于该值视为低置信
RETRIEVAL_MIN_SCORE=0.3
# 复杂/抽象/多跳问题检索加深系数（多路 top_k 与 rerank 候选数按该系数放大）
RETRIEVAL_DEPTH_SCALE=1.5
# 71题开发集消融为负，默认关闭；仅在冻结评测中显式开启。
ASPECT_RETRIEVAL_ENABLED=false
DOCUMENT_SECTION_COVERAGE_ENABLED=false
DOCUMENT_SECTION_COVERAGE_LIMIT=90
DOCUMENT_SECTION_DENSE_LIMIT=60
DOCUMENT_SECTION_CHILD_LIMIT=60
DOCUMENT_SECTION_QUERY_LIMIT=10
DOCUMENT_SECTION_PRESERVE_K=20
DOCUMENT_SECTION_HEAD_RATIO=0.8
# Development-gated narrative candidate expansion; enable only after frozen-pool rerank validation.
ADJACENT_PAGE_ENABLED=false
ADJACENT_PAGE_SEED_K=20
ADJACENT_PAGE_RADIUS=1
ADJACENT_PAGE_MAX_CANDIDATES=120
CONTEXT_COMPRESSION_ENABLED=true
CONTEXT_BLOCK_MAX_CHARS=1600
CONTEXT_TOTAL_MAX_CHARS=12000

# ===== 路由 / HyDE（阶段二）=====
INTENT_ROUTING_ENABLED=true
HYDE_ENABLED=true

# ===== OCR（PaddleOCR AI Studio 在线 API；扫描件文本提取率 <80% 时按需触发；图片上传需 OCR_ENABLED=true）=====
OCR_ENABLED=false
PPOCR_TOKEN=
PPOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PPOCR_MODEL=PP-StructureV3
PPOCR_POLL_INTERVAL=5    # 异步任务轮询间隔（秒）
PPOCR_TIMEOUT=60         # 单次 HTTP 超时（秒）

# ===== 切分（Small-to-Big + 语义精切）=====
CHUNK_MIN_TOKENS=128
CHUNK_TARGET_TOKENS=200
CHUNK_MAX_TOKENS=256
CHUNK_PARENT_TARGET_TOKENS=3072   # 章节级父块目标（2~4K 区间中值）
TABLE_MAX_TOKENS=2048             # 超过则表格"摘要+分页"
# 语义精切（结构优先、语义为辅）：对超长散文叶子按相邻句相似度断点切分
SEMANTIC_CHUNK_REFINE=true
SEMANTIC_SPLIT_SIM_THRESHOLD=0.5  # 相邻句相似度低于该值视为主题切换
SEMANTIC_MIN_SENTENCES=6          # 句子数少于该值的叶子不精切

# ===== 上传 / 陈旧文档防护 =====
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=2000
MAX_IMAGE_PIXELS=80000000
MAX_ARCHIVE_ENTRIES=10000
MAX_ARCHIVE_UNCOMPRESSED_MB=512
MAX_ARCHIVE_RATIO=200
CLAMAV_SCAN_ENABLED=false
CLAMAV_COMMAND=clamdscan
CLAMAV_TIMEOUT=30
# 同名文件上传 → 替换旧版（sha256 相同则幂等返回，不重复入库）
UPLOAD_REPLACE_SAME_FILENAME=true
UPLOAD_DIR=./data/uploads
PIPELINE_DIR=./data/pipeline
REGISTRY_DB=./data/registry.db
# 生产可设为 postgresql+psycopg://newrag@app-db:5432/newrag；密码不写进 URL。
REGISTRY_DATABASE_URL=
REGISTRY_DB_PASSWORD=
REGISTRY_DB_PASSWORD_FILE=
EVIDENCE_GRAPH_ENABLED=false

# ===== 数据清洗（解析/OCR 之后、章节树之前）=====
CLEAN_ENABLE=true
CLEAN_NFKC=true                 # NFKC 归一化（全角→半角，统一数字/百分号/逗号）
CLEAN_HEADER_FOOTER=true        # 页眉/页脚去重
CLEAN_HEADER_FOOTER_MIN_RATIO=0.5   # 行出现页数占比 >= 该值视为高频
CLEAN_HEADER_FOOTER_MAX_TOKENS=24   # 高频行 token 上限（页眉/页脚通常为短行）
CLEAN_HEADER_FOOTER_MARGIN=0.15     # 页首/页尾边缘区比例（超出该区的行不删）

# ===== 外部 API 缓解（缓存 + 限流 + 重试）=====
# 语义答案缓存：无会话单轮问答按"问题向量相似度 >= 阈值"复用整份回答（省掉 rerank + LLM 生成两段最贵调用）
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
# 命中后二次校验：问题文本字符重合度低于该值视为可疑（防御向量误命中）
ANSWER_CACHE_MIN_OVERLAP=0.5
# 嵌入结果缓存 TTL（相同文本复用稠密+稀疏向量，省外部调用；dense 与 dense&sparse 分 key）
EMBED_CACHE_TTL=86400
# 入库文本向量默认不写 Redis；>0 时单独设置文档缓存 TTL
EMBED_DOCUMENT_CACHE_TTL=0
# 语义答案缓存 TTL / 每 org+visibility 桶内最大条目
ANSWER_CACHE_TTL=3600
ANSWER_CACHE_MAX_ENTRIES=50
# 外部 API 并发上限（超限排队，防 429；建议 <= 套餐并发配额）
MAX_EMBED_CONCURRENCY=8
MAX_LLM_CONCURRENCY=4
MAX_RERANK_CONCURRENCY=4

# ===== 阶段四：异步任务 + 可观测 =====
# 任务后端：background=FastAPI BackgroundTasks（进程内线程池，默认） / celery=独立 worker（需启动 celery worker）
TASK_BACKEND=background
# OTel 可观测：console=本地日志，otlp=发送到 Collector/Phoenix/Tempo
OTEL_ENABLED=false
OTEL_EXPORTER=console
OTEL_OTLP_ENDPOINT=http://localhost:4318
OTEL_SAMPLE_RATIO=0.1

# ===== 会话（多轮记忆，Redis；Redis 不可用时静默降级为无状态）=====
SESSION_WINDOW=10
