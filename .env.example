# ===== 服务 =====
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ===== 存储 =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks
REDIS_URL=redis://localhost:6379

# ===== 嵌入 =====
# backend: api(百炼, 推荐) | flagembedding(本地 torch) | mock(测试用, 无真实语义)
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_BACKEND=api
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=./data/models
# API 后端（百炼 OpenAI 兼容；qwen3.7-text-embedding = 1024 维）
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=16

# ===== LLM（OpenAI 兼容；DeepSeek / Qwen 通用）=====
# provider: openai | mock(未配置密钥时的开发模拟，禁止生产使用)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
# 轻量模型（多模型路由：simple 问题走轻量，complex 走主模型；留空则全部走主模型）
LLM_LIGHT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_LIGHT_API_KEY=
LLM_LIGHT_MODEL=qwen3.5-flash

# ===== 重排序（阶段二）=====
# backend: api（百炼 workspace 网关 rerank） | none（RRF 直出，不重排）
RERANK_BACKEND=none
# 例：workspace 网关 https://{ws-id}.cn-beijing.maas.aliyuncs.com；公共端点 https://dashscope.aliyuncs.com
RERANK_API_BASE=https://dashscope.aliyuncs.com
RERANK_API_KEY=
RERANK_MODEL=qwen3-rerank
# workspace 网关路径；公共端点路径为 /api/v1/services/rerank/text-rerank/generation
RERANK_API_PATH=/api/v1/services/rerank/text-rerank/text-rerank
RERANK_CANDIDATES=50

# ===== 检索（阶段二：混合检索）=====
RECALL_DENSE_TOP_K=50
RECALL_SPARSE_TOP_K=50
RECALL_TABLE_TOP_K=20
RRF_K=60
RETRIEVAL_TOP_K=8

# ===== 路由 / 查询重写 / HyDE（阶段二）=====
INTENT_ROUTING_ENABLED=true
QUERY_REWRITE_ENABLED=true
HYDE_ENABLED=true
HYDE_MAX_TOKENS=256

# ===== OCR（PaddleOCR AI Studio 在线 API；扫描件文本提取率 <80% 时按需触发；图片上传需 OCR_ENABLED=true）=====
OCR_ENABLED=false
PPOCR_TOKEN=
PPOCR_JOB_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PPOCR_MODEL=PP-StructureV3

# ===== 检索（阶段一：单路 dense）=====
RECALL_DENSE_TOP_K=50
RETRIEVAL_TOP_K=8

# ===== 切分 =====
CHUNK_MIN_TOKENS=128
CHUNK_TARGET_TOKENS=200
CHUNK_MAX_TOKENS=256
OVERLAP_TOKENS=20

# ===== 上传 =====
MAX_UPLOAD_MB=50
UPLOAD_DIR=./data/uploads
PIPELINE_DIR=./data/pipeline
REGISTRY_DB=./data/registry.db
