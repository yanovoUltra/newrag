# ===== 服务 =====
APP_ENV=development
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ===== 存储 =====
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks
REDIS_URL=redis://localhost:6379

# ===== 嵌入 =====
# backend: api(百炼, 推荐) | flagembedding(本地 torch) | mock(测试用, 无真实语义)
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_BACKEND=api
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=./data/models
# API 后端（百炼 OpenAI 兼容；qwen3.7-text-embedding = 1024 维）
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=16

# ===== LLM（OpenAI 兼容；DeepSeek / Qwen 通用）=====
# provider: openai | mock(未配置密钥时的开发模拟，禁止生产使用)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ===== OCR（百度智能云，可选；扫描件文本提取率 <80% 时按需触发）=====
OCR_ENABLED=false
OCR_PROVIDER=baidu
OCR_API_KEY=
OCR_SECRET_KEY=

# ===== 检索（阶段一：单路 dense）=====
RECALL_DENSE_TOP_K=50
RETRIEVAL_TOP_K=8

# ===== 切分 =====
CHUNK_MIN_TOKENS=128
CHUNK_TARGET_TOKENS=200
CHUNK_MAX_TOKENS=256
OVERLAP_TOKENS=20

# ===== 上传 =====
MAX_UPLOAD_MB=50
UPLOAD_DIR=./data/uploads
PIPELINE_DIR=./data/pipeline
REGISTRY_DB=./data/registry.db
